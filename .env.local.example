# Boucle virale X/Twitter : A L'ARRET.
# Renseigner ces cles ne suffit PAS a la rallumer : il faut aussi repasser
# TWEET_CHAMPION_ACTIF a true dans lib/twitter.ts.
# Compte développeur X avec droit d'écriture, OAuth 1.0a "User context"
# (Keys and tokens > Access Token and Secret avec permission Read and Write).
TWITTER_API_KEY=
TWITTER_API_KEY_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_ACCOUNT_HANDLE=daywinnerlol
